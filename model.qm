<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.3" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Shared" stereotype="0x00">
  <attribute name="signals" type="enum" visibility="0x04" properties="0x00">
   <code>{
    /* 中断/端口事件 */
    MB_FRAME_RCVED_SIG = Q_USER_SIG, /* on_frame_received -&gt; modbus_app */
    MB_TX_TIMEOUT_SIG,               /* on_tx_timeout -&gt; modbus_app */

    /* modbus_app 内部 */
    MB_START_FAILED_SIG,             /* modbus_app 自投递 */
    MB_SAVE_TIMER_SIG,               /* QTimeEvt -&gt; modbus_app */
    MB_RETRY_TIMER_SIG,              /* QTimeEvt -&gt; modbus_app */

    /* modbus_app &lt;-&gt; calibrate_app 组件（直接派发，不排队） */
    CAL_ENTER_SIG,
    CAL_EXIT_SIG,
    CAL_SELECT_SIG,                  /* 选择通道/类型，带 cal_select_evt_t 载荷 */
    CAL_LOW_SIG,
    CAL_HIGH_SIG,
    CAL_COMMIT_SIG,
    CAL_ABORT_SIG,
    CAL_TIMEOUT_SIG,
    CAL_SETTLE_TIMER_SIG,
    CAL_SAMPLE_TIMER_SIG,
    CAL_CHANNEL_TIMER_SIG,

    /* channel_app &lt;-&gt; modbus_app / calibrate_app 契约 */
    CH_DATA_SIG,
    CH_CONFIG_SIG,
    CH_CAL_ENTER_SIG,
    CH_CAL_READY_SIG,
    CH_CAL_EXIT_SIG,

    /* cold_junction_app 发布-订阅 */
    CJ_TEMP_SIG,

    /* modbus_app &lt;-&gt; storage_app */
    PARAM_SAVE_SIG,
    PARAM_SAVED_SIG,
    PARAM_SAVE_FAILED_SIG,
    STORAGE_RETRY_TIMER_SIG,
    CAL_SAVE_SIG,
    CAL_SAVED_SIG,
    CAL_SAVE_FAILED_SIG,

    /* storage_app 自投递的完成事件（Reminder） */
    STORAGE_MORE_SIG,
    STORAGE_DONE_SIG,
    STORAGE_FAIL_SIG,

    APP_SIG_MAX
};</code>
  </attribute>
 </package>
 <package name="App" stereotype="0x00">
  <class name="modbus_app" superclass="qpc::QActive">
   <attribute name="slave" type="modbus_slave_t*" visibility="0x02" properties="0x00"/>
   <attribute name="saveTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="retryTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="calTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="image" type="modbus_image_t" visibility="0x02" properties="0x00"/>
   <attribute name="calUnlocked" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="calChannel" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="calType" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="calMagicStep" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="calMagicTick" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="lastFrameTick" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="saveFirstTick" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="devFaults" type="uint16_t" visibility="0x02" properties="0x00"/>
   <attribute name="txTimeouts" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="cal" type="calibrate_app" visibility="0x02" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <action>QHSM_INIT(&amp;me-&gt;cal.super, NULL, 0U);</action>
     <initial_glyph conn="64,5,5,0,-10,4">
      <action box="-10,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="operating">
     <initial target="../8">
      <initial_glyph conn="46,16,5,0,10,4">
       <action box="1,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="CAL_TIMEOUT">
      <action>lock_hidden(me);
dispatch_cal(me, &amp;cal_exit_evt);</action>
      <tran_glyph conn="15,16,3,-1,13">
       <action box="0,-2,13,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_ENTER, CAL_EXIT, CAL_SELECT, CAL_LOW, CAL_HIGH, CAL_COMMIT, CAL_ABORT, CAL_SETTLE_TIMER, CAL_SAMPLE_TIMER, CAL_CHANNEL_TIMER, CH_CAL_READY, CAL_SAVED, CAL_SAVE_FAILED">
      <action>dispatch_cal(me, e);</action>
      <tran_glyph conn="15,37,3,-1,18">
       <action box="0,-19,18,19"/>
      </tran_glyph>
     </tran>
     <tran trig="CH_DATA">
      <action>meas_evt_t const* evt = Q_EVT_CAST(meas_evt_t);

if ( evt-&gt;channel &lt; MODBUS_REG_CH_COUNT ) {
    me-&gt;image.ch[evt-&gt;channel].value =
        (evt-&gt;status != 0U) ? MODBUS_IMAGE_INVALID_VALUE : evt-&gt;value;
    me-&gt;image.ch[evt-&gt;channel].status = evt-&gt;status;
}</action>
      <tran_glyph conn="15,45,3,-1,10">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CJ_TEMP">
      <action>meas_evt_t const* evt = Q_EVT_CAST(meas_evt_t);

me-&gt;image.cj_value  = evt-&gt;value;
me-&gt;image.cj_status = evt-&gt;status;</action>
      <tran_glyph conn="15,49,3,-1,10">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="PARAM_SAVED">
      <action>me-&gt;devFaults &amp;= (uint16_t)~MODBUS_APP_DEV_FAULT_SAVE;</action>
      <tran_glyph conn="15,53,3,-1,19">
       <action box="0,-2,13,2"/>
      </tran_glyph>
     </tran>
     <tran trig="PARAM_SAVE_FAILED">
      <action>me-&gt;devFaults |= MODBUS_APP_DEV_FAULT_SAVE;</action>
      <tran_glyph conn="15,57,3,-1,19">
       <action box="0,-2,18,2"/>
      </tran_glyph>
     </tran>
     <tran trig="MB_SAVE_TIMER">
      <action>uint32_t now = board_tick_get();
bool recent_frame;
bool cap_reached;

if ( me-&gt;saveFirstTick == 0U ) {
    me-&gt;saveFirstTick = now;
}
recent_frame = ((uint32_t)(now - me-&gt;lastFrameTick) &lt; 500U) ? true
                                                            : false;
cap_reached  = ((uint32_t)(now - me-&gt;saveFirstTick) &gt;= 10000U) ? true
                                                               : false;

if ( recent_frame &amp;&amp; !cap_reached ) {
    (void)QTimeEvt_rearm(&amp;me-&gt;saveTimer, 500U);
} else if ( storage_app_get() != NULL ) {
    QACTIVE_POST(storage_app_get(), &amp;param_save_evt, me);
    me-&gt;saveFirstTick = 0U;
}</action>
      <tran_glyph conn="15,61,3,-1,19">
       <action box="0,-2,14,2"/>
      </tran_glyph>
     </tran>
     <state name="serving">
      <entry>modbus_slave_status_t start_status;

if ( me-&gt;slave == NULL ) {
    QACTIVE_POST(&amp;me-&gt;super, &amp;start_failed_evt, &amp;me-&gt;super);
} else {
    start_status = modbus_slave_start(me-&gt;slave);
    if ( start_status != MODBUS_SLAVE_OK ) {
        elog_error(&quot;modbus&quot;, &quot;slave start failed (%d)&quot;,
                   (int)start_status);
        QACTIVE_POST(&amp;me-&gt;super, &amp;start_failed_evt, &amp;me-&gt;super);
    } else {
        modbus_slave_set_running(me-&gt;slave, 1U);
    }
}</entry>
      <exit>if ( me-&gt;slave != NULL ) {
    modbus_slave_stop(me-&gt;slave);
    modbus_slave_set_running(me-&gt;slave, 0U);
}
lock_hidden(me);
dispatch_cal(me, &amp;cal_exit_evt);</exit>
      <tran trig="MB_FRAME_RCVED">
       <action>me-&gt;lastFrameTick = board_tick_get();
if ( me-&gt;slave != NULL ) {
    (void)modbus_slave_advance(me-&gt;slave);
}</action>
       <tran_glyph conn="42,30,3,-1,16">
        <action box="0,-2,16,2"/>
       </tran_glyph>
      </tran>
      <tran trig="MB_TX_TIMEOUT">
       <action>++me-&gt;txTimeouts;
elog_warn(&quot;modbus&quot;, &quot;tx timeout&quot;);</action>
       <tran_glyph conn="42,34,3,-1,16">
        <action box="0,-2,14,2"/>
       </tran_glyph>
      </tran>
      <tran trig="MB_START_FAILED" target="../../9">
       <tran_glyph conn="54,40,2,0,4">
        <action box="0,0,16,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="42,20,20,20">
       <entry box="0,3,6,2"/>
       <exit box="0,5,6,2"/>
      </state_glyph>
     </state>
     <state name="fault">
      <entry>if ( me-&gt;slave != NULL ) {
    modbus_slave_stop(me-&gt;slave);
}
QTimeEvt_armX(&amp;me-&gt;retryTimer, 5000U, 0U);</entry>
      <exit>QTimeEvt_disarm(&amp;me-&gt;retryTimer);</exit>
      <tran trig="MB_RETRY_TIMER" target="../../8">
       <tran_glyph conn="50,44,0,2,-4">
        <action box="-16,-2,16,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="2" node="42,44,20,9">
       <entry box="0,3,6,2"/>
       <exit box="0,5,6,2"/>
      </state_glyph>
     </state>
     <state_glyph node="15,9,59,55"/>
    </state>
    <state_diagram size="89,69"/>
   </statechart>
  </class>
  <class name="storage_app" superclass="qpc::QActive">
   <attribute name="retryTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="deferQ" type="QEQueue" visibility="0x02" properties="0x00"/>
   <attribute name="pendingCal" type="cal_ch_record_t" visibility="0x02" properties="0x00"/>
   <attribute name="pendingCalChannel" type="uint8_t" visibility="0x02" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1/2">
     <initial_glyph conn="30,5,5,0,-10,17">
      <action box="-10,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="storage">
     <tran trig="PARAM_SAVE">
      <action>QActive_defer(me, &amp;me-&gt;deferQ, e);</action>
      <tran_glyph conn="4,14,3,-1,13">
       <action box="0,-2,13,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_SAVE">
      <action> QActive_defer(me, &amp;me-&gt;deferQ, e);</action>
      <tran_glyph conn="4,18,3,-1,13">
       <action box="0,-2,11,2"/>
      </tran_glyph>
     </tran>
     <state name="idle">
      <entry>while ( QActive_recall(me, &amp;me-&gt;deferQ) ) {}</entry>
      <tran trig="PARAM_SAVE">
       <choice target="../../../3">
        <guard brief="dirty_mask">param_app_dirty_mask()</guard>
        <choice_glyph conn="24,31,4,3,-12,21">
         <action box="0,-14,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../..">
        <guard>else</guard>
        <choice_glyph conn="24,31,4,3,4,-18">
         <action box="-6,2,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="6,31,3,-1,18">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_SAVE" target="../../4">
       <action>storage_note_cal_save(me, Q_EVT_CAST(cal_save_evt_t));
QACTIVE_POST(me, STORAGE_STEP, NULL);</action>
       <tran_glyph conn="30,35,1,3,15">
        <action box="0,-2,11,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="6,22,24,19">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="writing_params">
      <entry>storage_write_param_step(me);</entry>
      <tran trig="STORAGE_MORE" target="..">
       <tran_glyph conn="61,19,1,1,4,-2,-4">
        <action box="0,-4,15,2"/>
       </tran_glyph>
      </tran>
      <tran trig="STORAGE_DONE" target="../../2">
       <tran_glyph conn="45,23,3,1,-11,4,-4">
        <action box="-15,-2,15,2"/>
       </tran_glyph>
      </tran>
      <tran trig="STORAGE_FAIL" target="../../5">
       <tran_glyph conn="61,21,1,1,8,38,-39">
        <action box="-9,34,13,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="45,12,16,13">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="writing_cal">
      <entry>storage_write_cal_step(me);</entry>
      <tran trig="STORAGE_DONE" target="../../2">
       <tran_glyph conn="45,31,3,1,-15">
        <action box="-13,-2,14,2"/>
       </tran_glyph>
      </tran>
      <tran trig="STORAGE_FAIL" target="../../2">
       <tran_glyph conn="45,39,3,1,-15">
        <action box="-13,-2,13,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_SAVE">
       <tran_glyph conn="61,37,1,-1,-11">
        <action box="-10,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="45,29,16,12">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="fault">
      <entry>// arm retry timer 5s</entry>
      <exit>// disarm</exit>
      <tran trig="STORAGE_RETRY_TIMER">
       <choice target="../../../3">
        <guard brief="dirty_mask">param_app_dirty_mask()</guard>
        <choice_glyph conn="27,55,5,1,38,-32,-4">
         <action box="3,-2,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../2">
        <guard>else</guard>
        <choice_glyph conn="27,55,4,2,-4,-11,-10">
         <action box="-11,-6,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="6,55,3,-1,21">
        <action box="0,-2,21,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="2" node="6,45,24,16">
       <entry box="0,3,6,2"/>
       <exit box="0,5,6,2"/>
      </state_glyph>
     </state>
     <state_glyph node="4,7,72,57"/>
    </state>
    <state_diagram size="81,66"/>
   </statechart>
  </class>
  <class name="calibrate_app" superclass="qpc::QHsm">
   <attribute name="container" type="QActive*" visibility="0x02" properties="0x00"/>
   <attribute name="pending" type="cal_ch_record_t" visibility="0x02" properties="0x00"/>
   <attribute name="rawLow" type="int32_t" visibility="0x02" properties="0x00"/>
   <attribute name="rawHigh" type="int32_t" visibility="0x02" properties="0x00"/>
   <attribute name="sampleCount" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="sampleSum" type="int32_t" visibility="0x02" properties="0x00"/>
   <attribute name="gain" type="int32_t" visibility="0x02" properties="0x00"/>
   <attribute name="offset" type="int32_t" visibility="0x02" properties="0x00"/>
   <attribute name="status" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="error" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="channel" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="type" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="exitPending" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="settleTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="sampleTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="channelTimer" type="QTimeEvt" visibility="0x02" properties="0x00"/>
   <statechart properties="0x00">
    <initial target="../1">
     <initial_glyph conn="44,42,5,0,-12,4">
      <action box="-10,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="idle">
     <entry>me-&gt;status = CAL_STATUS_IDLE;
me-&gt;error  = CAL_ERROR_NONE;</entry>
     <tran trig="CAL_ENTER">
      <action>me-&gt;status = CAL_STATUS_IDLE;
me-&gt;error  = CAL_ERROR_NONE;
memset(&amp;me-&gt;pending, 0, sizeof(me-&gt;pending));
me-&gt;rawLow  = 0L;
me-&gt;rawHigh = 0L;
me-&gt;gain    = 0L;
me-&gt;offset  = 0L;</action>
      <tran_glyph conn="13,55,3,-1,13">
       <action box="0,-2,11,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_SELECT">
      <choice target="../../../2">
       <guard>select_valid(e)</guard>
       <action>start_select(me, e);</action>
       <choice_glyph conn="26,59,5,3,48">
        <action box="14,-2,13,2"/>
       </choice_glyph>
      </choice>
      <choice target="../../../3">
       <guard>else</guard>
       <action>me-&gt;error = CAL_ERROR_INVALID_CHANNEL_TYPE;</action>
       <choice_glyph conn="26,59,4,0,18">
        <action box="0,6,6,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="13,59,3,-1,13">
       <action box="0,-2,11,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_LOW, CAL_HIGH, CAL_COMMIT" target="../../3">
      <action>me-&gt;error = CAL_ERROR_NOT_SELECTED;</action>
      <tran_glyph conn="13,66,3,0,9,11">
       <action box="0,-5,12,5"/>
      </tran_glyph>
     </tran>
     <state_glyph node="13,46,27,22">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="active">
     <exit>QActive* channel;

stop_component_timers(me);
channel = channel_app_get(me-&gt;channel);
if ( channel != NULL ) {
    QACTIVE_POST(channel, &amp;cal_exit_evt, me-&gt;container);
} else {
    elog_warn(&quot;calibrate&quot;, &quot;channel %u has no AO to resume&quot;,
              (unsigned)me-&gt;channel);
}</exit>
     <initial target="../3">
      <initial_glyph conn="104,49,5,0,-9,4">
       <action box="-9,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="CAL_EXIT, CAL_ABORT" target="../../1">
      <tran_glyph conn="74,52,3,1,-34">
       <action box="-19,-2,19,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_SELECT, CAL_LOW, CAL_HIGH, CAL_COMMIT">
      <action>me-&gt;error = CAL_ERROR_BUSY;</action>
      <tran_glyph conn="74,57,3,-1,13">
       <action box="0,-7,13,7"/>
      </tran_glyph>
     </tran>
     <state name="waiting_channel">
      <entry>me-&gt;status = CAL_STATUS_WAITING_CHANNEL;</entry>
      <tran trig="CH_CAL_READY">
       <action>uint32_t settle_delay_ms = 0U;</action>
       <choice target="../../../4">
        <guard brief="ok">configure_input(me, &amp;settle_delay_ms)</guard>
        <action>(void)QTimeEvt_disarm(&amp;me-&gt;channelTimer);
QTimeEvt_armX(&amp;me-&gt;settleTimer, settle_delay_ms + 50U, 0U);</action>
        <choice_glyph conn="106,61,5,0,5,15">
         <action box="1,-2,5,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../3">
        <guard>else</guard>
        <action>me-&gt;error = CAL_ERROR_CONFIG_FAILED;</action>
        <choice_glyph conn="106,61,4,1,6,-36,17,-30">
         <action box="-38,4,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="90,61,3,-1,16">
        <action box="0,-2,15,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_CHANNEL_TIMER" target="../../../3">
       <action>me-&gt;error = CAL_ERROR_CHANNEL_NOT_READY;</action>
       <tran_glyph conn="90,63,3,1,-24,17,-26">
        <action box="-35,-2,19,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,53,30,19">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="settling">
      <entry>me-&gt;status = CAL_STATUS_SETTLING;</entry>
      <tran trig="CAL_SETTLE_TIMER" target="../../5">
       <tran_glyph conn="90,84,3,0,18,7">
        <action box="0,-2,17,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,76,30,11">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="settled">
      <entry>me-&gt;status = CAL_STATUS_SETTLED;</entry>
      <tran trig="CAL_LOW" target="../../6">
       <action>start_capture_low(me);</action>
       <tran_glyph conn="90,99,3,0,10,7">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,91,30,11">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="capturing_low">
      <entry>me-&gt;sampleCount = 0U;
me-&gt;sampleSum   = 0L;
me-&gt;status      = CAL_STATUS_CAPTURING_LOW;
QTimeEvt_armX(&amp;me-&gt;sampleTimer, 100U, 0U);</entry>
      <tran trig="CAL_SAMPLE_TIMER">
       <action>bool ok = sample_once(me);</action>
       <choice>
        <guard brief="ok,&lt;16">ok &amp;&amp; me-&gt;sampleCount &lt; CAL_SAMPLE_COUNT</guard>
        <action>QTimeEvt_armX(&amp;me-&gt;sampleTimer, 100U, 0U);</action>
        <choice_glyph conn="107,114,5,-1,9">
         <action box="1,-2,8,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../8">
        <guard brief="ok,=16">ok</guard>
        <action>me-&gt;rawLow = me-&gt;sampleSum / (int32_t)CAL_SAMPLE_AVERAGE;
(void)QTimeEvt_disarm(&amp;me-&gt;sampleTimer);</action>
        <choice_glyph conn="107,114,4,0,15">
         <action box="0,3,8,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../3">
        <guard>else</guard>
        <action>me-&gt;error = CAL_ERROR_CAPTURE_FAILED;</action>
        <choice_glyph conn="107,114,4,1,4,-25,-30,-42">
         <action box="-39,-28,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="90,114,3,-1,17">
        <action box="0,-2,17,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,106,30,19">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="capturing_high">
      <entry>me-&gt;sampleCount = 0U;
me-&gt;sampleSum   = 0L;
me-&gt;status      = CAL_STATUS_CAPTURING_HIGH;
QTimeEvt_armX(&amp;me-&gt;sampleTimer, 100U, 0U);</entry>
      <tran trig="CAL_SAMPLE_TIMER">
       <action>bool ok = sample_once(me);</action>
       <choice>
        <guard brief="ok,&lt;16">ok &amp;&amp; me-&gt;sampleCount &lt; CAL_SAMPLE_COUNT</guard>
        <action>QTimeEvt_armX(&amp;me-&gt;sampleTimer, 100U, 0U);</action>
        <choice_glyph conn="108,159,5,-1,9">
         <action box="1,-2,8,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../9">
        <guard brief="ok,=16">ok</guard>
        <action>me-&gt;rawHigh = me-&gt;sampleSum / (int32_t)CAL_SAMPLE_AVERAGE;
(void)QTimeEvt_disarm(&amp;me-&gt;sampleTimer);</action>
        <choice_glyph conn="108,159,4,0,12">
         <action box="0,3,10,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../3">
        <guard>else</guard>
        <action>me-&gt;error = CAL_ERROR_CAPTURE_FAILED;</action>
        <choice_glyph conn="108,159,4,2,4,-87,-69">
         <action box="-24,2,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="90,159,3,-1,18">
        <action box="0,-2,18,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,151,30,16">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="low_captured">
      <entry>me-&gt;status = CAL_STATUS_LOW_CAPTURED;</entry>
      <tran trig="CAL_HIGH" target="../../7">
       <action>start_capture_high(me);</action>
       <tran_glyph conn="90,141,3,0,10,10">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_LOW" target="../../6">
       <action>start_capture_low(me);</action>
       <tran_glyph conn="90,137,3,2,10,-12">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,129,30,18">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="high_captured">
      <entry>me-&gt;status = CAL_STATUS_HIGH_CAPTURED;</entry>
      <tran trig="CAL_LOW" target="../../6">
       <action>start_capture_low(me);</action>
       <tran_glyph conn="90,183,3,1,38,-72,-8">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_HIGH" target="../../7">
       <action>start_capture_high(me);</action>
       <tran_glyph conn="90,179,3,1,34,-23,-4">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_COMMIT">
       <action>cal_error_t error = commit(me);</action>
       <choice target="../../../10">
        <guard brief="ok"/>
        <choice_glyph conn="105,187,4,0,9">
         <action box="0,6,10,2"/>
        </choice_glyph>
       </choice>
       <choice>
        <guard>else</guard>
        <action>me-&gt;error = (uint8_t)error;</action>
        <choice_glyph conn="105,187,5,-1,7">
         <action box="1,-2,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="90,187,3,-1,15">
        <action box="0,-2,12,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,171,30,21">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="saving">
      <entry>me-&gt;status      = CAL_STATUS_SAVING;
me-&gt;exitPending = 0U;</entry>
      <tran trig="CAL_ABORT">
       <action>me-&gt;error = CAL_ERROR_BUSY;</action>
       <tran_glyph conn="90,204,3,-1,12">
        <action box="0,-2,11,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_EXIT">
       <action>me-&gt;exitPending = 1U;</action>
       <tran_glyph conn="90,208,3,-1,12">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_SAVE_FAILED">
       <action>discard_pending(me);
me-&gt;error = CAL_ERROR_SAVE_FAILED;</action>
       <choice target="../../../9">
        <guard brief="!exitPending">me-&gt;exitPending == 0U</guard>
        <choice_glyph conn="102,212,5,3,-16,-38,4">
         <action box="-12,-2,12,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../3">
        <guard>else</guard>
        <choice_glyph conn="102,212,4,2,4,-86,-122">
         <action box="-18,2,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="120,212,1,-1,-18">
        <action box="-16,-2,16,2"/>
       </tran_glyph>
      </tran>
      <tran trig="CAL_SAVED">
       <action>apply_pending(me);</action>
       <choice target="../../../../4">
        <guard brief="!exitPending">me-&gt;exitPending == 0U</guard>
        <choice_glyph conn="103,220,4,2,4,67,-168">
         <action box="1,2,11,2"/>
        </choice_glyph>
       </choice>
       <choice target="../../../../1">
        <guard>else</guard>
        <action>// pending 提交到 app_cal_data 并应用</action>
        <choice_glyph conn="103,220,5,0,29,-182,-104,8">
         <action box="1,-2,6,2"/>
        </choice_glyph>
       </choice>
       <tran_glyph conn="90,220,3,-1,13">
        <action box="0,-2,11,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="90,196,30,30">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state_glyph node="74,44,81,184">
      <exit box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="error">
     <entry>me-&gt;status = CAL_STATUS_ERROR;</entry>
     <tran trig="CAL_SELECT">
      <choice target="../../../2">
       <guard>select_valid(e)</guard>
       <action>me-&gt;error = CAL_ERROR_NONE;
start_select(me, e);</action>
       <choice_glyph conn="26,92,5,3,48">
        <action box="14,-2,14,2"/>
       </choice_glyph>
      </choice>
      <choice>
       <guard>else</guard>
       <action>me-&gt;error = CAL_ERROR_INVALID_CHANNEL_TYPE;</action>
       <choice_glyph conn="26,92,4,-1,-7">
        <action box="0,-5,10,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="13,92,3,-1,13">
       <action box="0,-2,12,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_ABORT, CAL_EXIT, CAL_ENTER" target="../../1">
      <tran_glyph conn="30,77,0,2,-9">
       <action box="0,-7,11,5"/>
      </tran_glyph>
     </tran>
     <state_glyph color="2" node="13,77,27,17">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="done">
     <entry>me-&gt;status = CAL_STATUS_DONE;
me-&gt;error  = CAL_ERROR_NONE;</entry>
     <tran trig="CAL_SELECT">
      <choice target="../../../2">
       <guard>select_valid(e)</guard>
       <action>start_select(me, e);</action>
       <choice_glyph conn="170,52,5,1,-15">
        <action box="-13,-2,13,2"/>
       </choice_glyph>
      </choice>
      <choice target="../../../3">
       <guard>else</guard>
       <action>me-&gt;error = CAL_ERROR_INVALID_CHANNEL_TYPE;</action>
       <choice_glyph conn="170,52,4,3,-22,-161,54,4">
        <action box="-68,-24,6,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="187,52,1,-1,-17">
       <action box="-12,-2,12,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_ABORT, CAL_EXIT, CAL_ENTER" target="../../1">
      <tran_glyph conn="166,44,0,0,-10,-142,12">
       <action box="-64,-12,30,2"/>
      </tran_glyph>
     </tran>
     <tran trig="CAL_LOW, CAL_HIGH, CAL_COMMIT" target="../../3">
      <action>me-&gt;error = CAL_ERROR_NOT_SELECTED;</action>
      <tran_glyph conn="174,44,0,3,-18,-169,62,8">
       <action box="-72,-20,30,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="159,44,28,12">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="193,234"/>
   </statechart>
  </class>
 </package>
 <directory name="./app/inc">
  <file name="common_app.h" properties="external"/>
  <file name="modbus_app.h" properties="external"/>
  <file name="calibrate_app.h" properties="external"/>
  <file name="storage_app.h" properties="external"/>
 </directory>
 <directory name="./app/src">
  <file name="modbus_app.c" properties="external"/>
  <file name="calibrate_app.c" properties="external"/>
  <file name="storage_app.c" properties="external"/>
 </directory>
</model>
